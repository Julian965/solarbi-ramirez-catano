  "id": null,
  "uid": "solarbi-g01-ramirez-catano",
  "title": "SolarBI Pascual · Monitoreo operativo del inversor (G01)",
  "description": "Grupo 01 · Julián Ramirez Molina y Nicolas Cataño Durango. Mismos datos que Power BI (base solarbi en PostgreSQL).",
  "tags": [
    "solarbi",
    "grupo01",
    "monitoreo"
  ],
  "timezone": "America/Bogota",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "2026-10-05T05:00:00.000Z",
    "to": "2026-10-08T05:00:00.000Z"
  },
